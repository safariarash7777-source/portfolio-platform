# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# سرویس‌رول — فقط سرور؛ برای verify پرداخت و وبهوک تلگرام (هرگز public نشود)
SUPABASE_SERVICE_ROLE_KEY=

# آدرس سایت (برای callback زرین‌پال و لینک‌ها)
NEXT_PUBLIC_SITE_URL=

# Zarinpal (server-only)
ZARINPAL_MERCHANT_ID=
# «1» یا «true» → حالت sandbox (تست بدون پول واقعی)
ZARINPAL_SANDBOX=
# قیمت خرید دسترسی، به تومان (مرجع معتبر مبلغ سمت سرور و نمایش UI)
NEXT_PUBLIC_COURSE_PRICE_TOMAN=

# Telegram Bot (server-only، مگر username)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
# نام کاربری بات بدون @ (برای دیپ‌لینک «باز کردن بات» در داشبورد)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# نام کاربریِ کانالِ عمومی بدون @ — پست‌هایش خودکار در «آخرین تحلیل‌ها» می‌آید
# (فیدِ t.me/s/؛ پیش‌فرض arashsafariiiiiiii). کانالِ خصوصیِ پولی این نیست.
TELEGRAM_PUBLIC_CHANNEL_USERNAME=

# Resend (server-only) — ارسال ایمیل تأیید پرداخت
RESEND_API_KEY=
RESEND_FROM=

# Iran Market Relay (optional — enables gold/currency/funds data from domestic sources)
# منبعِ اصلیِ سایت، اسنپ‌شاتِ Supabase است (جدولِ ir_market_snapshots) که با
# NEXT_PUBLIC_SUPABASE_URL/ANON_KEYِ بالا خوانده می‌شود — env جدیدی لازم نیست.
# رله (روی لیارا) داده را به Supabase می‌فرستد؛ برای همین، این envها روی *لیارا*
# ست می‌شوند نه اینجا: SUPABASE_URL و SUPABASE_SERVICE_ROLE_KEY (رجوع به relay/README.md).
#
# دو envِ زیر فقط برای مسیرِ دومِ اختیاری (fetchِ زندهٔ رله، وقتی لینکِ بین‌الملل
# بالا باشد) است؛ با معماریِ Supabase لازم نیستند و می‌توانند خالی بمانند.
IR_MARKET_RELAY_URL=
IR_MARKET_RELAY_TOKEN=

# Leads Webhook — رمزِ مشترکِ بینِ Mini App و سایت.
# Mini App همین رشته را در هدرِ «X-Webhook-Secret» به POST /api/leads/webhook
# می‌فرستد و باید در *هر دو* سرویس یکسان باشد (در Mini App هم نامش همین است).
# اگر ست نباشد، وبهوک همیشه ۴۰۱ می‌دهد و لید ثبت نمی‌شود.
PLATFORM_WEBHOOK_SECRET=

# منسوخ (DEPRECATED) — نامِ قدیمی که هرگز توسط کدی خوانده نمی‌شد. فقط برای اینکه
# نصب‌های موجود نشکنند هنوز به‌عنوانِ fallback پذیرفته می‌شود. خالی بگذارید و از
# PLATFORM_WEBHOOK_SECRET استفاده کنید؛ پس از تأییدِ staging حذف می‌شود (ADR-003).
LEADS_WEBHOOK_SECRET=

# Cron (server-only) — رمزِ محافظت از GET /api/cron/alerts.
# Vercel این مقدار را خودکار به‌صورت هدرِ «Authorization: Bearer <CRON_SECRET>»
# به فراخوانی‌های cron اضافه می‌کند. یک رشتهٔ تصادفیِ قوی بگذارید.
CRON_SECRET=

# ── هشدارِ بازتوازن (phase33) ───────────────────────────────────────────────
# کانال‌های فعال، جداشده با ویرگول: log | email | telegram
# ⚠️ تنظیم‌نشده یا خالی ⇒ فقط `log` (گیرندهٔ آزمایشی؛ هیچ پیامی به عضو واقعی
# نمی‌رود). عمداً پیش‌فرضِ امن است: یک اشتباهِ پیکربندی نباید به صندوقِ ورودیِ
# آدم‌های واقعی برسد.
REBALANCE_ALERT_CHANNELS=log
# انحراف از چند واحدِ درصد به بعد ارزشِ اطلاع‌دادن دارد.
REBALANCE_ALERT_THRESHOLD_POINTS=5
# حداقل فاصله تا هشدارِ بعدی، به ساعت.
REBALANCE_ALERT_COOLDOWN_HOURS=24
# حداکثر تلاشِ ارسال برای هر کانال. هر تلاش جداگانه ثبت می‌شود.
REBALANCE_ALERT_MAX_ATTEMPTS=2
# سقفِ تلاش روی همهٔ اجراها. بعد از آن رویداد `exhausted` می‌شود و دفتر
# بی‌انتها رشد نمی‌کند.
REBALANCE_ALERT_MAX_TOTAL_ATTEMPTS=5
# تلاشِ بازِ کهنه‌تر از این، «رهاشده» حساب می‌شود و نتیجه‌اش `unknown` ثبت
# می‌شود. ⚠️ کوچک‌بودنش یعنی دو پردازشِ کُند هم‌زمان می‌فرستند؛ بزرگ‌بودنش
# یعنی بازیابیِ دیرهنگام.
REBALANCE_ALERT_ATTEMPT_LEASE_MINUTES=10
