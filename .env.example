# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# سرویس‌رول — فقط سرور؛ برای verify پرداخت و وبهوک تلگرام (هرگز public نشود)
SUPABASE_SERVICE_ROLE_KEY=

# آدرس سایت (برای callback زرین‌پال و لینک‌ها)
NEXT_PUBLIC_SITE_URL=

# Zarinpal (server-only)
ZARINPAL_MERCHANT_ID=
# «1» یا «true» → حالت sandbox (تست بدون پول واقعی)
ZARINPAL_SANDBOX=
# قیمت خرید دسترسی، به تومان (مرجع معتبر مبلغ سمت سرور و نمایش UI)
NEXT_PUBLIC_COURSE_PRICE_TOMAN=

# Telegram Bot (server-only، مگر username)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
# نام کاربری بات بدون @ (برای دیپ‌لینک «باز کردن بات» در داشبورد)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# نام کاربریِ کانالِ عمومی بدون @ — پست‌هایش خودکار در «آخرین تحلیل‌ها» می‌آید
# (فیدِ t.me/s/؛ پیش‌فرض arashsafariiiiiiii). کانالِ خصوصیِ پولی این نیست.
TELEGRAM_PUBLIC_CHANNEL_USERNAME=

# Resend (server-only) — ارسال ایمیل تأیید پرداخت
RESEND_API_KEY=
RESEND_FROM=

# Iran Market Relay (optional — enables gold/currency/funds data from domestic sources)
# منبعِ اصلیِ سایت، اسنپ‌شاتِ Supabase است (جدولِ ir_market_snapshots) که با
# NEXT_PUBLIC_SUPABASE_URL/ANON_KEYِ بالا خوانده می‌شود — env جدیدی لازم نیست.
# رله (روی لیارا) داده را به Supabase می‌فرستد؛ برای همین، این envها روی *لیارا*
# ست می‌شوند نه اینجا: SUPABASE_URL و SUPABASE_SERVICE_ROLE_KEY (رجوع به relay/README.md).
#
# دو envِ زیر فقط برای مسیرِ دومِ اختیاری (fetchِ زندهٔ رله، وقتی لینکِ بین‌الملل
# بالا باشد) است؛ با معماریِ Supabase لازم نیستند و می‌توانند خالی بمانند.
IR_MARKET_RELAY_URL=
IR_MARKET_RELAY_TOKEN=

# Leads Webhook (shared secret between miniapp and platform)
LEADS_WEBHOOK_SECRET=

# FX Dashboard (داشبوردِ نرخ ارز — Streamlit، پوشهٔ fx-dashboard/، روی لیارا داخلِ ایران)
# داشبورد در /admin/fx داخلِ iframe می‌آید. چون روی دامنهٔ دیگری است، middleware
# این سایت آن را گیت نمی‌کند؛ محافظت با توکنِ امضاشدهٔ کوتاه‌عمر است
# (lib/fxToken.ts اینجا ↔ fx-dashboard/auth_gate.py آنجا).
# FX_DASHBOARD_URL روی CSP هم اثر می‌گذارد (frame-src در next.config.js) —
# بعد از تغییرش باید Redeploy بزنید، وگرنه مرورگر قاب را بلاک می‌کند.
FX_DASHBOARD_URL=
# کلیدِ مشترک با اپِ لیارا. باید **دقیقاً همان مقدار** در متغیرِ FX_EMBED_SECRET
# لیارا هم باشد. هرگز NEXT_PUBLIC_ نشود و هرگز کامیت نشود.
# ساخت: openssl rand -base64 48
FX_EMBED_SECRET=

# Cron (server-only) — رمزِ محافظت از GET /api/cron/alerts.
# Vercel این مقدار را خودکار به‌صورت هدرِ «Authorization: Bearer <CRON_SECRET>»
# به فراخوانی‌های cron اضافه می‌کند. یک رشتهٔ تصادفیِ قوی بگذارید.
CRON_SECRET=
