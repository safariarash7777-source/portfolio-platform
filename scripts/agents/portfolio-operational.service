[Unit]
Description=Portfolio deterministic data and site monitors
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/portfolio-operational.lock /usr/bin/node /opt/portfolio-operational/worker.cjs
TimeoutStartSec=100
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
# Docker access is privileged. Only root-owned reviewed fixed code may be installed here.
