    "catalogSQL": "BEGIN TRANSACTION READ ONLY;\nSET LOCAL statement_timeout='15s';\nSELECT jsonb_build_object(\n 'schemas',(SELECT coalesce(jsonb_agg(nspname ORDER BY nspname),'[]'::jsonb) FROM pg_namespace WHERE nspname LIKE 'consultation%'),\n 'relations',(SELECT coalesce(jsonb_agg(jsonb_build_object('schema',n.nspname,'name',c.relname,'kind',c.relkind,'rls',c.relrowsecurity,'forced',c.relforcerowsecurity) ORDER BY n.nspname,c.relname),'[]'::jsonb) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname LIKE 'consultation%' OR (n.nspname='public' AND c.relname LIKE 'consultation_%')),\n 'functions',(SELECT coalesce(jsonb_agg(jsonb_build_object('schema',n.nspname,'name',p.proname,'arguments',pg_get_function_identity_arguments(p.oid),'definitionMd5',md5(pg_get_functiondef(p.oid))) ORDER BY n.nspname,p.proname,p.oid),'[]'::jsonb) FROM pg_proc p JOIN pg_namespace n ON n.oid=p.pronamespace WHERE p.prokind IN('f','p') AND (n.nspname LIKE 'consultation%' OR (n.nspname='public' AND (p.proname LIKE '%consultation%' OR p.proname LIKE '%ticket%')))))::text;\nCOMMIT;",
