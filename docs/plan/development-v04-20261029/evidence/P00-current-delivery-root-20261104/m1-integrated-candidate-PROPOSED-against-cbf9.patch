+            check(isinstance(value[field], str) and value[field] == self.context.get(env), 'owned_run_binding_changed')
+        check(re.fullmatch(r'[1-9][0-9]{0,19}', value['runId']) and re.fullmatch(r'[1-9][0-9]{0,5}', value['attempt']) and re.fullmatch(r'[a-f0-9]{40}', value['sourceCommit']), 'owned_context_shape')
+        check(isinstance(value['allocationId'], str) and re.fullmatch(r'[a-f0-9]{32}', value['allocationId']), 'owned_allocation_id')
