+            check(item['name'] == 'start-a-owned-' + value['allocationId'] + '-' + role and isinstance(item['id'], str) and re.fullmatch(r'[a-f0-9]{64}', item['id']) and isinstance(item['image'], str) and re.fullmatch(r'sha256:[a-f0-9]{64}', item['image']), 'owned_resource_identity')
+        check(value['source']['id'] != value['copy']['id'] and value['source']['image'] == value['copy']['image'], 'owned_resources_not_independent')
