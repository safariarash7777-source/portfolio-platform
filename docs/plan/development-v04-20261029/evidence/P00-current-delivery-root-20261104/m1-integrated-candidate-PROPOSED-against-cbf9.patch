+            if item['kind']=='S':
+                sequences[key]=json.loads(self.query('BEGIN READ ONLY; SELECT jsonb_build_object(\'lastValue\',last_value,\'isCalled\',is_called) FROM '+identifier+'; COMMIT;',role))
+            else:
