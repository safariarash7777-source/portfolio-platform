+        data={};sequences={}
+        for item in relations:
+            check(isinstance(item,dict) and set(item)=={'schema','name','kind'},'m1_relation_shape')
+            identifier=m1_identifier(item['schema'])+'.'+m1_identifier(item['name'])
+            key=item['schema']+'.'+item['name']
+            check(key not in data and key not in sequences,'m1_relation_collision')
+            if item['kind']=='v':
