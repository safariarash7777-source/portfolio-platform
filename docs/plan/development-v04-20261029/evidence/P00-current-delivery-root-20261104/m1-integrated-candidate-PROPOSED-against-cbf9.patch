+class OwnedDockerIO:
+    """Caller issues recipe and observes IDs; adapter never chooses its own trust pin."""
+    def __init__(self, store, allocation, expected_sha, process=bounded_owned_process):
+        check(isinstance(expected_sha,str) and re.fullmatch(r'[a-f0-9]{64}',expected_sha),'m1_caller_pin_missing')
+        import hashlib
+        check(hashlib.sha256(json.dumps(allocation,sort_keys=True,separators=(',',':')).encode()).hexdigest()==expected_sha,'m1_caller_binding_changed')
+        self.store,self.allocation,self.process=store,json.loads(json.dumps(allocation)),process
+        self.ids={allocation[r]['id']:r for r in ('source','copy','restore')}
+        check(len(self.ids)==3 and all(re.fullmatch(r'[a-f0-9]{64}',x) for x in self.ids),'m1_three_distinct_ids_required')
+
+    def __getattr__(self,name):
+        check(name in ('exists','read','read_blob','write_exclusive','write_blob_exclusive','lock_exclusive'),'m1_unknown_io_method')
+        return getattr(self.store,name)
+
+    def inspect(self,object_id):
+        check(object_id in self.ids,'m1_foreign_target')
+        result=self.process(['docker','inspect',object_id],timeout=10,max_stdout_bytes=262144)
+        check(result['exitCode']==0,'m1_inspect_failed')
+        value=json.loads(result['stdout']);check(isinstance(value,list) and len(value)==1,'m1_inspect_shape')
+        row=value[0];role=self.ids[object_id];expected=self.allocation[role]
+        m1_verify_image(self.process,expected.get('imageContract'))
+        check(row['Id']==object_id and row['Name']=='/'+expected['name'] and row['Image']==expected['image'],'m1_resource_identity_changed')
+        check(row['State']['Running'] is True and row['HostConfig']['NetworkMode']=='none' and not row['HostConfig'].get('PortBindings') and not any((row['NetworkSettings'].get('Ports') or {}).values()) and set(row['NetworkSettings'].get('Networks',{}))=={'none'},'m1_resource_isolation_changed')
+        labels=row['Config'].get('Labels') or {}
+        check(all(labels.get(k)==v for k,v in expected['labels'].items()),'m1_resource_labels_changed')
+        mounts=row['Mounts'];check(len(mounts)==1 and mounts[0]['Type']=='tmpfs' and mounts[0]['Destination']=='/var/lib/postgresql/data' and mounts[0]['RW'] is True,'m1_data_mount_changed')
+        check([x for x in row['Config'].get('Env',[]) if x.startswith('PGDATA=')]==['PGDATA=/var/lib/postgresql/data'],'m1_pgdata_changed')
+        return row
+
+    def execute(self,argv,body=None,*,timeout=90,max_stdout_bytes=64*1024*1024):
+        prefix=['docker','exec','-i','-e','PGOPTIONS=-c lock_timeout=5s -c statement_timeout=60s']
+        check(argv[:5]==prefix and len(argv)>6 and argv[5] in self.ids,'m1_command_target_invalid')
+        programs=[['psql','-XqAt','-U','postgres','-d','postgres','-v','ON_ERROR_STOP=1'],['pg_dump','-U','postgres','-d','postgres','--format=custom','--no-password'],['pg_dump','-U','postgres','-d','postgres','--schema-only','--no-password'],['pg_restore','-U','postgres','-d','postgres','--exit-on-error','--single-transaction']]
+        check(argv[6:] in programs,'m1_program_not_allowed')
+        for object_id in self.ids:self.inspect(object_id)
+        # Recheck source health, IDs and namespace marker on every target operation.
+        source=self.inspect(self.allocation['source']['id']);check(source['State'].get('Health',{}).get('Status')=='healthy','m1_source_unhealthy')
+        marker_sql=b"BEGIN READ ONLY; SELECT current_setting('portfolio.owned_copy_marker',true); COMMIT;"
+        for object_id in self.ids:
+            marker=self.process(prefix+[object_id]+programs[0],marker_sql,timeout=10,max_stdout_bytes=256)
+            check(marker['exitCode']==0 and marker['stdout'].decode().strip()==self.allocation['databaseMarker'],'m1_namespace_marker_changed')
+        exact=list(argv)
+        if exact[6]=='psql':exact+=['-v','VERBOSITY=verbose']
+        return self.process(exact,body,timeout=timeout,max_stdout_bytes=max_stdout_bytes)
