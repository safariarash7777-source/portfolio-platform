+# M1 helpers remain within the existing START-A adapter. No native entry point.
+def bounded_owned_process(argv, body=None, *, timeout=90, max_stdout_bytes=64*1024*1024, popen=None):
+    import subprocess
+    import threading
+    import time
+    check(isinstance(argv,list) and all(isinstance(x,str) for x in argv) and argv[0]=='docker', 'm1_fixed_docker_required')
+    check(body is None or isinstance(body,bytes) and len(body)<=64*1024*1024, 'm1_input_bound')
+    check(type(timeout) is int and 1<=timeout<=90 and type(max_stdout_bytes) is int and 0<max_stdout_bytes<=64*1024*1024, 'm1_transport_limits')
+    env={'PATH':os.environ.get('PATH',''),'LANG':'C.UTF-8','DOCKER_HOST':'unix:///var/run/docker.sock','DOCKER_CONFIG':'/nonexistent-start-a-owned-client'}
+    try:child=(popen or subprocess.Popen)(argv,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,env=env,shell=False)
+    except Exception:raise RuntimeError('m1_process_start_failed') from None
+    chunks=[bytearray(),bytearray()];errors=[];done=[threading.Event() for _ in range(3)]
+    def drain(index,stream,limit):
+        try:
+            while True:
+                part=stream.read(min(65536,limit-len(chunks[index])+1))
+                if not part:break
+                if len(chunks[index])+len(part)>limit:raise RuntimeError('m1_output_bound')
+                chunks[index].extend(part)
+        except Exception:errors.append('m1_stream_failed')
+        finally:done[index].set()
+    def feed():
+        try:
+            value=body or b''
+            for offset in range(0,len(value),65536):child.stdin.write(value[offset:offset+65536])
+            child.stdin.close()
+        except BrokenPipeError:errors.append('m1_input_broken_pipe')
+        except Exception:errors.append('m1_input_failed')
+        finally:done[2].set()
+    for fn,args in [(drain,(0,child.stdout,max_stdout_bytes)),(drain,(1,child.stderr,65536)),(feed,())]:threading.Thread(target=fn,args=args,daemon=True).start()
+    deadline=time.monotonic()+timeout
+    try:
+        while not all(x.is_set() for x in done) or child.poll() is None:
+            if any(x!='m1_input_broken_pipe' for x in errors) or time.monotonic()>=deadline:raise RuntimeError('m1_process_incomplete')
+            time.sleep(.005)
+        code=child.wait(timeout=1)
+        check(not errors or code!=0 and all(x=='m1_input_broken_pipe' for x in errors), 'm1_process_incomplete')
+        # Only this reviewed SQLSTATE is exposed; raw stderr never leaves IO.
+        sqlstate='PT409' if code!=0 and re.search(rb'(?m)^ERROR:\s+PT409:',bytes(chunks[1])) else None
+        return {'exitCode':code,'stdout':bytes(chunks[0]),'sqlstate':sqlstate}
+    except Exception:
+        child.kill()  # Only the child this call created, never a container/other PID.
+        child.wait(timeout=5)
+        raise RuntimeError('m1_process_incomplete') from None
+    finally:
+        for stream in (child.stdin,child.stdout,child.stderr):
+            try:stream.close()
+            except Exception:pass
