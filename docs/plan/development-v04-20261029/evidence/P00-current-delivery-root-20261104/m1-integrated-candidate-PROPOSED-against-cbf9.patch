+class OwnedPrivateStore:
+    """Fixed flat namespace; Linux descriptor-based nofollow exclusive evidence."""
+    def __init__(self, path):
+        import stat
+        check(hasattr(os,'O_NOFOLLOW') and hasattr(os,'O_DIRECTORY'), 'm1_linux_fs_required')
+        self.path=Path(path)
+        check(self.path.is_absolute(), 'm1_absolute_store_required')
+        # Walk from the root descriptor. O_NOFOLLOW applies to EVERY component;
+        # leaf is never reopened by a raceable full path.
+        fd=os.open('/',os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW)
+        try:
+            for part in self.path.parts[1:]:
+                check(part not in ('.','..'),'m1_store_component')
+                child=os.open(part,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW,dir_fd=fd)
+                try:
+                    meta=os.fstat(child)
+                    check(stat.S_ISDIR(meta.st_mode) and meta.st_uid in (0,os.getuid()),'m1_store_ancestor_unsafe')
+                except Exception:
+                    os.close(child);raise
+                os.close(fd);fd=child
+            meta=os.fstat(fd)
+            check(meta.st_uid==os.getuid() and not meta.st_mode&0o077,'m1_store_owner_mode')
+            self.fd=fd;fd=None
+        finally:
+            if fd is not None:os.close(fd)
+
+    def name(self,name):
+        check(isinstance(name,str) and re.fullmatch(r'[a-z][a-z0-9.-]{0,90}',name) and '..' not in name, 'm1_evidence_name')
+        return name
+
+    def exists(self,name):
+        import stat
+        try:meta=os.stat(self.name(name),dir_fd=self.fd,follow_symlinks=False)
+        except FileNotFoundError:return False
+        check(stat.S_ISREG(meta.st_mode) and meta.st_nlink==1 and meta.st_uid==os.getuid() and not meta.st_mode&0o077,'m1_evidence_unsafe')
+        return True
+
+    def write_blob_exclusive(self,name,raw):
+        import stat
+        check(isinstance(raw,bytes) and len(raw)<=64*1024*1024,'m1_blob_bound')
+        fd=os.open(self.name(name),os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_NOFOLLOW,0o600,dir_fd=self.fd)
+        try:
+            meta=os.fstat(fd);check(stat.S_ISREG(meta.st_mode) and meta.st_nlink==1,'m1_evidence_unsafe')
+            view=memoryview(raw)
+            while view:
+                count=os.write(fd,view);check(count>0,'m1_write_incomplete');view=view[count:]
+            os.fsync(fd)
+        finally:os.close(fd)
+        os.fsync(self.fd)
+
+    def read_blob(self,name,limit):
+        import stat
+        check(type(limit) is int and 0<limit<=64*1024*1024,'m1_read_bound')
+        fd=os.open(self.name(name),os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=self.fd)
+        try:
+            before=os.fstat(fd)
+            check(stat.S_ISREG(before.st_mode) and before.st_nlink==1 and before.st_uid==os.getuid() and not before.st_mode&0o077 and before.st_size<=limit,'m1_evidence_unsafe')
+            result=bytearray()
+            while len(result)<=before.st_size:
+                part=os.read(fd,min(65536,before.st_size+1-len(result)))
+                if not part:break
+                result.extend(part)
+            after=os.fstat(fd);path=os.stat(name,dir_fd=self.fd,follow_symlinks=False)
+            identity=lambda m:(m.st_dev,m.st_ino,m.st_size,m.st_mtime_ns,m.st_ctime_ns,m.st_nlink)
+            check(len(result)==before.st_size and identity(before)==identity(after)==identity(path),'m1_evidence_changed')
+            return bytes(result)
+        finally:os.close(fd)
+
+    def write_exclusive(self,name,value):self.write_blob_exclusive(name,json.dumps(value,sort_keys=True,allow_nan=False).encode())
+    def read(self,name):
+        def unique(pairs):
+            value=dict(pairs);check(len(value)==len(pairs),'m1_duplicate_json');return value
+        return json.loads(self.read_blob(name,2*1024*1024).decode('utf-8'),object_pairs_hook=unique,parse_constant=lambda _:check(False,'m1_json_invalid'))
+
+    def lock_exclusive(self):
+        import fcntl
+        from contextlib import contextmanager
+        @contextmanager
+        def locked():
+            # Lock file cannot be attacker supplied symlink/hardlink or other owner.
+            import stat
+            fd=os.open('allocation.lock',os.O_RDWR|os.O_CREAT|os.O_NOFOLLOW,0o600,dir_fd=self.fd)
+            try:
+                meta=os.fstat(fd);check(stat.S_ISREG(meta.st_mode) and meta.st_nlink==1 and meta.st_uid==os.getuid() and not meta.st_mode&0o077,'m1_lock_unsafe')
+                fcntl.flock(fd,fcntl.LOCK_EX|fcntl.LOCK_NB)
+                yield
+            finally:os.close(fd)
+        return locked()
+
+    def close(self):os.close(self.fd)
