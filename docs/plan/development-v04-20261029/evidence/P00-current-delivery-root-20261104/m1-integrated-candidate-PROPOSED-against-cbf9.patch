+def m1_schema_bytes(raw):
+    check(isinstance(raw,bytes) and 0<len(raw)<=16*1024*1024,'m1_schema_bound')
+    # pg_dump17 restrict nonces are transport tokens, not schema. Strip ONLY a
+    # paired, identical generated nonce; every other SQL/comment byte retained.
+    lines=raw.splitlines(keepends=True);start=[];end=[]
+    for i,line in enumerate(lines):
+        if re.fullmatch(rb'\\restrict [A-Za-z0-9]+\r?\n?',line):start.append((i,line.split()[1]))
+        if re.fullmatch(rb'\\unrestrict [A-Za-z0-9]+\r?\n?',line):end.append((i,line.split()[1]))
+    check((not start and not end) or len(start)==len(end)==1 and start[0][1]==end[0][1] and start[0][0]<=12 and end[0][0]>=len(lines)-4 and start[0][0]<end[0][0] and b'-- PostgreSQL database dump complete' in b''.join(lines[-10:]),'m1_schema_nonce_unpaired')
+    remove={i for i,_ in start+end};return b''.join(line for i,line in enumerate(lines) if i not in remove)
